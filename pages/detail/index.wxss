/* 护牛羊 · 操作指引 */

.guide-tabs {
  margin-bottom: 22rpx;
}

.guide-banner {
  position: relative;
  width: 100%;
  height: 290rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-2);
  border: 1rpx solid rgba(22, 36, 27, 0.08);
}

.guide-banner-img {
  width: 100%;
  height: 100%;
}

.guide-banner-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(16, 28, 20, 0.1) 0%, rgba(16, 28, 20, 0.78) 100%);
}

.guide-banner-badge {
  position: absolute;
  top: 18rpx;
  left: 20rpx;
  padding: 6rpx 16rpx;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #fff;
  border-radius: 999rpx;
  background: rgba(35, 72, 45, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.guide-banner-copy {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  bottom: 20rpx;
}

.guide-banner-kicker {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #eeddbb;
}

.guide-banner-title {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.35;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.45);
}

.guide-intro {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(44, 86, 55, 0.12);
  border-radius: 28rpx;
  background: linear-gradient(140deg, #eff3e6 0%, #f8f3e4 100%);
  box-shadow: 0 1rpx 2rpx rgba(22, 36, 27, 0.03);
}

.guide-icon-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: rgba(255, 253, 247, 0.82);
  border: 1rpx solid rgba(44, 86, 55, 0.1);
}

.guide-icon-tile image {
  width: 52rpx;
  height: 52rpx;
}

.guide-intro-copy {
  flex: 1;
  min-width: 0;
}

.guide-kicker {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--brass);
}

.guide-title {
  margin-top: 4rpx;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: -0.4rpx;
  color: var(--ink);
}

.guide-subtitle {
  margin-top: 2rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.guide-steps {
  margin-top: 20rpx;
  padding: 6rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--card);
  box-shadow: var(--shadow-1);
}

.guide-step {
  display: flex;
  gap: 22rpx;
  padding: 28rpx 0;
}

.guide-step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 52rpx;
  flex-shrink: 0;
}

.guide-number {
  font-family: var(--serif);
  font-style: italic;
  font-size: 34rpx;
  line-height: 1.15;
  color: var(--brass-2);
}

.guide-line {
  width: 1rpx;
  flex: 1;
  margin-top: 12rpx;
  background: linear-gradient(rgba(22, 36, 27, 0.14), rgba(22, 36, 27, 0.02));
}

.guide-step-copy {
  flex: 1;
  min-width: 0;
  padding-bottom: 4rpx;
}

.guide-step-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
}

.guide-step-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.82;
  color: var(--ink-3);
}

.guide-notice {
  margin: 24rpx 0;
}
