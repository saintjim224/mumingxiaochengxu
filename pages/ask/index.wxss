/* 问问牧小安 */

.assistant-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(44, 86, 55, 0.12);
  border-radius: 30rpx;
  background: linear-gradient(140deg, #eef3e7 0%, #f8f2e3 100%);
  box-shadow: 0 1rpx 2rpx rgba(22, 36, 27, 0.03);
}

.assistant-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.assistant-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 253, 247, 0.9);
  box-shadow: 0 8rpx 20rpx -10rpx rgba(22, 36, 27, 0.45);
}

.assistant-online {
  position: absolute;
  right: 2rpx;
  bottom: 4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #6cb47c;
  border: 4rpx solid #f2f3e8;
}

.assistant-copy {
  flex: 1;
  min-width: 0;
}

.assistant-kicker {
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  color: var(--brass);
}

.assistant-name {
  margin-top: 2rpx;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
  color: var(--ink);
}

.assistant-sub {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.assistant-quote {
  margin: 18rpx 4rpx 0;
  font-family: var(--serif);
  font-size: 25rpx;
  font-style: italic;
  line-height: 1.7;
  color: var(--muted);
}

/* ---------- 常见问题 ---------- */

.question-list {
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--card);
  overflow: hidden;
  box-shadow: var(--shadow-1);
}

button.question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink-2);
  text-align: left;
}

button.question:last-child {
  border-bottom: 0;
}

.question-text {
  flex: 1;
  min-width: 0;
}

.question-arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1;
  color: var(--muted-2);
}

/* ---------- 对话 ---------- */

.conversation {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.message.user {
  align-items: flex-end;
}

.message-meta {
  margin: 0 8rpx 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.message.user .message-meta {
  color: var(--pine-3);
}

.message-bubble {
  max-width: 88%;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  border-top-left-radius: 8rpx;
  background: var(--card);
  box-shadow: 0 1rpx 2rpx rgba(22, 36, 27, 0.03);
}

.message.user .message-bubble {
  border-color: transparent;
  border-radius: 22rpx;
  border-top-right-radius: 8rpx;
  background: linear-gradient(140deg, #38694a, #20452c);
  box-shadow: 0 12rpx 24rpx -16rpx rgba(24, 56, 36, 0.7);
  color: #fffdf4;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.78;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-source {
  margin: 8rpx 8rpx 0;
  font-size: 20rpx;
  color: var(--muted);
}

.thinking {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 8rpx 20rpx;
  font-size: 24rpx;
  color: var(--pine);
}

.thinking-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--pine-3);
  animation: live-pulse 1.4s ease-in-out infinite;
}

.ask-error {
  margin-bottom: 20rpx;
}

/* ---------- 输入 ---------- */

.composer {
  margin-top: 8rpx;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--card);
  box-shadow: var(--shadow-1);
}

.composer-label {
  margin-bottom: 8rpx;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--muted);
}

.composer-input {
  width: 100%;
  min-height: 150rpx;
  padding: 16rpx 4rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: var(--ink);
}

.composer-btn {
  margin-top: 14rpx;
}
