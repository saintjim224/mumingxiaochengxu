/* 算草料 */

.feed-hero-banner {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-2);
  border: 1rpx solid rgba(22, 36, 27, 0.08);
}

.feed-hero-img {
  width: 100%;
  height: 100%;
}

.feed-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(16, 28, 20, 0.1) 0%, rgba(16, 28, 20, 0.78) 100%);
}

.feed-hero-tag {
  position: absolute;
  top: 16rpx;
  left: 18rpx;
  padding: 4rpx 14rpx;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
  color: #fff;
  border-radius: 999rpx;
  background: rgba(142, 103, 51, 0.88);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.feed-hero-copy {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 18rpx;
}

.feed-hero-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.35;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.feed-hero-desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #f5edd8;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

.form-card {
  padding: 8rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  background: var(--card);
  box-shadow: var(--shadow-1);
}

.form-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0 6rpx;
}

.form-card-title {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.4rpx;
  color: var(--ink-2);
}

.form-card-hint {
  font-size: 21rpx;
  color: var(--muted);
}

.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.qty-row.last {
  border-bottom: 0;
  padding-bottom: 28rpx;
}

.qty-copy {
  min-width: 0;
}

.qty-label {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.qty-hint {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.stepper {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  background: var(--card-2);
  flex-shrink: 0;
}

button.step-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--card);
  color: var(--pine-2);
  font-size: 34rpx;
  line-height: 1;
  text-align: center;
}

.step-input {
  width: 104rpx;
  height: 68rpx;
  padding: 0;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.step-unit {
  padding: 0 8rpx 0 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.storage-input {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 0 4rpx 4rpx;
  border-bottom: 2rpx solid var(--line-2);
}

.storage-input-field {
  width: 168rpx;
  height: 66rpx;
  padding: 0;
  text-align: right;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.storage-unit {
  font-size: 23rpx;
  color: var(--muted);
}

/* ---------- 天数 ---------- */

.rate-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx dashed var(--line-2);
  border-radius: var(--r-md);
  background: rgba(255, 253, 247, 0.5);
  font-size: 23rpx;
  color: var(--ink-3);
  text-align: left;
}

.rate-copy {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rate-action {
  flex-shrink: 0;
  font-weight: 600;
  color: var(--pine);
}

.rate-card {
  margin-top: 14rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  background: var(--card);
}

.rate-note {
  margin-bottom: 6rpx;
}

.rate-input {
  width: 180rpx;
  text-align: center;
}

.calc-button {
  margin-top: 26rpx;
}

/* ---------- 结果 ---------- */

.result-card {
  margin-top: 26rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(44, 86, 55, 0.18);
  border-radius: 30rpx;
  background: linear-gradient(150deg, #edf2e5 0%, #f8f3e3 100%);
  box-shadow: 0 1rpx 2rpx rgba(22, 36, 27, 0.04), 0 20rpx 40rpx -28rpx rgba(22, 36, 27, 0.4);
  animation: fade-up 0.36s cubic-bezier(0.22, 0.9, 0.3, 1) both;
}

.result-card.is-short {
  border-color: rgba(167, 93, 69, 0.22);
  background: linear-gradient(150deg, #f7ece3 0%, #faf4e8 100%);
}

.result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 2.4rpx;
  color: var(--ink-3);
}

.result-big {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 6rpx;
  line-height: 1;
}

.result-num {
  font-size: 104rpx;
  font-weight: 600;
  line-height: 0.9;
  letter-spacing: -5rpx;
  color: var(--ink);
}

.result-unit {
  font-size: 30rpx;
  color: var(--ink-2);
}

.result-caption {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.result-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(44, 86, 55, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 253, 247, 0.68);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--pine-2);
}

.result-badge.warn {
  border-color: rgba(167, 93, 69, 0.26);
  color: #8f4a34;
}

.result-gauge {
  height: 10rpx;
  margin-top: 24rpx;
  border-radius: 5rpx;
  background: rgba(22, 36, 27, 0.08);
  overflow: hidden;
}

.result-gauge-fill {
  height: 100%;
  border-radius: 5rpx;
  background: linear-gradient(90deg, #6a9a74, #2c5637);
  transition: width 0.5s ease;
}

.is-short .result-gauge-fill {
  background: linear-gradient(90deg, #d8a184, #a75d45);
}

.result-rows {
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(22, 36, 27, 0.1);
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(22, 36, 27, 0.08);
  font-size: 26rpx;
  color: var(--ink-3);
}

.result-row:last-child {
  border-bottom: 0;
}

.result-value {
  font-weight: 600;
  color: var(--ink);
}

.result-value.is-warn {
  color: #8f4a34;
}

.result-summary {
  margin: 18rpx 0 24rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--ink-2);
}

.calc-note {
  margin-top: 26rpx;
  padding: 0 6rpx;
  text-align: center;
}
