/* pages/news/index.wxss - 经典微信原生聊天交互规范 */

page {
  background-color: #EDEDED;
  color: #1F2937;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部首席官切换 (白底分段器) */
.officer-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #E5E7EB;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3F4F6;
  border-radius: 30rpx;
  padding: 10rpx 14rpx;
  border: 1rpx solid #E5E7EB;
  transition: all 0.2s;
}

.tab-item.active {
  background: #E0F2FE;
  border-color: #0284C7;
}

.tab-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.tab-name {
  font-size: 22rpx;
  color: #4B5563;
}

.tab-item.active .tab-name {
  color: #0284C7;
  font-weight: bold;
}

/* 快捷提问栏 */
.quick-bar {
  background: #F9FAFB;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #E5E7EB;
}

.quick-title {
  font-size: 20rpx;
  color: #D97706;
  flex-shrink: 0;
  margin-right: 12rpx;
  font-weight: 500;
}

.quick-scroll {
  display: flex;
  white-space: nowrap;
}

.quick-chip {
  display: inline-block;
  background: #FFFFFF;
  border: 1rpx solid #D1D5DB;
  color: #374151;
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
}

/* 消息列表 */
.msg-scroll {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
}

.msg-row.ai {
  justify-content: flex-start;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.user-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #0284C7;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.msg-bubble-box {
  max-width: 530rpx;
  display: flex;
  flex-direction: column;
}

.user-box {
  align-items: flex-end;
}

.msg-sender-name {
  font-size: 20rpx;
  color: #9CA3AF;
  margin-bottom: 6rpx;
}

.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-all;
}

/* 微信经典白气泡 */
.ai-bubble {
  background: #FFFFFF;
  color: #111827;
  border: 1rpx solid #E5E7EB;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

/* 微信经典绿气泡 */
.user-bubble {
  background: #95EC69;
  color: #000000;
  border-top-right-radius: 4rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.03);
}

/* 底部输入框 */
.input-bar {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  padding: 16rpx 20rpx 36rpx;
  border-top: 1rpx solid #E5E7EB;
}

.chat-input {
  flex: 1;
  background: #FFFFFF;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #111827;
  margin-right: 16rpx;
}

.send-btn {
  background: #07C160;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: bold;
  padding: 14rpx 30rpx;
  border-radius: 12rpx;
}
